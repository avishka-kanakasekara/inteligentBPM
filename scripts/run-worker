#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_DIR="${ROOT_DIR}/.venv"

if [[ ! -d "${VENV_DIR}" ]]; then
  echo "Virtualenv missing. Run scripts/setup-backend first." >&2
  exit 1
fi

# shellcheck disable=SC1091
source "${VENV_DIR}/bin/activate"
export WORKFLOW_MODE="${WORKFLOW_MODE:-mock}"
export PYTHONPATH="${ROOT_DIR}/services/api:${PYTHONPATH:-}"
cd "${ROOT_DIR}/services/workflow_worker"
exec python -m workflow_worker.main
