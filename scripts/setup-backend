#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_DIR="${ROOT_DIR}/.venv"

echo "==> Creating Python virtual environment at ${VENV_DIR}"
python3 -m venv "${VENV_DIR}"
# shellcheck disable=SC1091
source "${VENV_DIR}/bin/activate"
python -m pip install --upgrade pip

echo "==> Installing shared contracts"
pip install -e "${ROOT_DIR}/packages/contracts[dev]"

echo "==> Installing API"
pip install -e "${ROOT_DIR}/services/api[dev]"
pip install -e "${ROOT_DIR}/packages/contracts"

echo "==> Installing workflow worker"
pip install -e "${ROOT_DIR}/services/workflow_worker[dev]"

echo "==> Backend setup complete (no Docker required)"
echo "Activate with: source ${VENV_DIR}/bin/activate"
