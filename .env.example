# Environment variable template
#
# Copy to `.env` (and split into frontend/backend env files when those
# packages exist). Fill with real values from YOUR development projects.
#
# Do NOT commit real secrets.
# Do NOT put service-role keys or provider secrets in Vite/frontend env.
# Do NOT invent fake production credentials.
#
# Docker / containers are NOT used in this project.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=local
APP_NAME=intelligent-bpm
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
# Leave empty to auto-generate per process; set for deterministic local debugging only
CORRELATION_ID_HEADER=X-Correlation-Id

# -----------------------------------------------------------------------------
# Frontend (public only — safe to expose to the browser)
# Also copy public vars to apps/web/.env for Vite
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_MOCK_API=true
# Foundation/dev only: set true to skip DB/Redis readiness probes
SKIP_DEPENDENCY_CHECKS=false

# -----------------------------------------------------------------------------
# Supabase (backend) — use the DEVELOPMENT project locally
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard → Project Settings → API → JWT Secret (not anon / service_role keys)
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# memory | postgres — use postgres when DATABASE_URL points at hosted Supabase
PERSISTENCE_MODE=memory
# Session pooler example:
# postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Optional: storage bucket names
SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents

# -----------------------------------------------------------------------------
# Redis — managed URL or local native install (not Docker)
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_REDIS_URL=

# -----------------------------------------------------------------------------
# Workflow orchestration
# WORKFLOW_MODE=mock|temporal
# -----------------------------------------------------------------------------
WORKFLOW_MODE=mock
TEMPORAL_HOST=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=bpm-process
# If using mTLS instead of API key, set cert paths (leave empty when unused)
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=

# -----------------------------------------------------------------------------
# Vertex AI / Gemini (official Google Gen AI Python SDK)
# Do not hardcode preview model IDs in application code; set stable IDs here.
# Leave unset to use the fake/mock Gemini client in early development and tests.
# Authentication: Application Default Credentials or workload identity
# (GOOGLE_APPLICATION_CREDENTIALS only for local key files; never commit keys).
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=

# Per-agent model routing (stable GA / configured IDs only — never preview hardcodes)
GEMINI_PLANNER_MODEL=
GEMINI_RESOURCE_MODEL=
GEMINI_RISK_MODEL=
GEMINI_EXECUTION_MODEL=
GEMINI_EMBEDDING_MODEL=
# Optional shared default / fallback when a per-agent model is unset
GEMINI_MODEL_ID=
GEMINI_FALLBACK_MODEL=

# Generation defaults
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=60
GEMINI_RETRY_COUNT=3
GEMINI_CIRCUIT_FAILURE_THRESHOLD=5
GEMINI_CIRCUIT_RESET_SECONDS=60
GEMINI_CLIENT_MODE=auto
# auto | vertex | fake  (fake never calls Vertex; used in tests)

# -----------------------------------------------------------------------------
# Tool gateway / integrations
# Empty credentials ⇒ mock adapters (email, suppliers, purchasing, billing)
# INTEGRATIONS_MODE=mock|auto  (auto uses real providers only when credentials exist)
# Store org-scoped secrets via encrypted vault (INTEGRATIONS_SECRET_KEY / APP_SIGNING_SECRET)
# Do NOT put raw API keys in normal database columns.
# -----------------------------------------------------------------------------
INTEGRATIONS_MODE=mock
INTEGRATIONS_SECRET_KEY=
APP_SIGNING_SECRET=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
# Examples:
# EMAIL_PROVIDER=brevo
# EMAIL_SMTP_HOST=smtp-relay.brevo.com
# EMAIL_FROM_ADDRESS=you@yourdomain.com
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxx
# EMAIL_FROM_ADDRESS=onboarding@resend.dev
SUPPLIER_API_BASE_URL=
SUPPLIER_API_KEY=
PURCHASING_API_BASE_URL=
PURCHASING_API_KEY=
BILLING_API_BASE_URL=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Plans / metering defaults (optional overrides)
# -----------------------------------------------------------------------------
DEFAULT_PLAN=pro
METERING_PERIOD_TZ=UTC

# -----------------------------------------------------------------------------
# Security / sessions
# -----------------------------------------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1
SESSION_COOKIE_SECURE=false
# Backend-only signing material for any app-issued tokens (if used); leave empty until implemented
APP_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Production hardening (native processes — no Docker)
# -----------------------------------------------------------------------------
CONTENT_SECURITY_POLICY=
CSP_REPORT_ONLY=false
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=26214400
RATE_LIMIT_PER_MINUTE=120
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=300
OUTBOUND_URL_ALLOWLIST=localhost,127.0.0.1,example.supabase.co,storage.googleapis.com,mail.mock.local,suppliers.mock.local,purchasing.mock.local
ENABLE_CSRF=true
ENABLE_RATE_LIMIT=true

# -----------------------------------------------------------------------------
# Observability (optional — native OTLP exporter; no containers required)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=intelligent-bpm-api
